//see https://dbdiagram.io/d/OpenFlightHub-6755970ee9daa85aca06b8ce


Table users {
  id serial [primary key, not null]
  team_id integer
  name text [not null]
  email text [not null] //encrypted
  email_hash text [not null] //bcrypt hash
  password text //scrypt hash base64 encoded
  login_token text //some unique token
  session_token text //some unique token
  stream_token text //some unique token
  reset_code text //some unique token
  created_at timestamptz [not null, default: `now()`]
  state integer [not null, default: 0, note: "0 = invited, 1 = live, 2 = locked, 3 = deleted"]
  locale text [not null, default: 'en-US']
}
Ref: users.team_id > teams.id

Table teams {
  id serial [primary key, not null]
  name text [not null]
  owner_user_id integer [not null]
  created_at timestamptz [not null, default: `now()`]
  state integer [not null, default: 0, note: "0 = invited, 1 = live, 2 = locked, 3 = deleted"]
  locale text [not null, default: 'en-US']
}
Ref: teams.owner_user_id > users.id

Table files {
  id serial [primary key, not null]
  workspace_id integer [not null]
  ext text [not null]
  name text [not null] // full original name including extension
  created_at timestamptz [not null, default: `now()`]
  created_by integer [not null]
  has_thumbnail boolean [not null, default: false]
  thumbnail_generation_has_failed boolean [not null, default: false]
  exif_data text//json encoded exif data
  exif_data_generation_has_failed boolean [not null, default: false]
}
Ref: files.workspace_id > workspaces.id
Ref: files.created_by > users.id


Table workspaces {
  id serial [primary key, not null]
  name text [not null]
  longitude float8 [not null]
  latitude float8 [not null]
}

Table workspace_permissions {
  team_id integer [primary key, not null]
  workspace_id integer [primary key, not null]
}
Ref: workspace_permissions.team_id > teams.id
Ref: workspace_permissions.workspace_id > workspaces.id

Table connections {
  id serial [primary key, not null]
  name text [not null]
  secret text [not null]//used as credential together with id
  session_token text
  workspace_id integer [not null]
  workspace_uuid text [not null, unique]// used for dji pilot 2 communication, format: xxxxxxxx-0000-42ae-84e6-123456789abc where xxx is the workspace_id like "00000001", the rest is random
  remote_controller_id integer
  last_drone_id integer // the "currently" connected drone (does not mean that the drone is currently online)
  stream_is_alive boolean [not null, default: false]
}
Ref: connections.workspace_id > workspaces.id
Ref: connections.remote_controller_id > remote_controllers.id
Ref: connections.last_drone_id > drones.id


Table remote_controllers {
  id serial [primary key, not null]
  serial_number text [not null, unique]
  type integer [not null, default: 0, note: "0 = unknown, 1 = dji rc plus, 2 = dji rc pro enterprise, 3 = dji rc plus 2, 4 = dji smart controller"]
}

Table drones {
  id serial [primary key, not null]
  serial_number text [not null, unique]
  name text [not null]
  type integer [not null, default: 0, note: "0 = unknown, 1 = dji matrice 300, 2 = dji matrice 30, 3 = dji matrice 350, 4 = dji mavic 3"]
  last_connection_id integer
  current_flight_id integer // should never every be null
  in_flight boolean [not null, default: false]
}
Ref: drones.last_connection_id > connections.id
Ref: drones.current_flight_id > flights.id


Table flights {
  id serial [primary key, not null]
  drone_id integer [not null]
  workspace_id integer [not null] // drones can change workspace, but this will always be the workspace_id at the time the flight was recorded
  started_at timestamptz [not null, default: `now()`]
  landed_at timestamptz// when drone lands
  ended_at timestamptz
}
Ref: flights.drone_id > drones.id
Ref: flights.workspace_id > workspaces.id

Table flight_data {
  id serial [primary key, not null]
  flight_id integer [not null]
  received_at timestamptz [not null, default: `now()`]// when stored in db
  created_at timestamptz [not null]// when drone created the data
  type integer [not null, note: "0 = position"]
  data jsonb [not null]
}
Ref: flight_data.flight_id > flights.id

Table remote_controller_data {
  id serial [primary key, not null]
  remote_controller_id integer [not null]
  type integer [not null, default: 0, note: "0 = position"]
  data jsonb [not null]
  created_at timestamptz [not null, default: `now()`]
}
Ref: remote_controller_data.remote_controller_id > remote_controllers.id

Table drone_data {
  id serial [primary key, not null]
  drone_id integer [not null]
  flight_id integer [not null]
  type integer [not null, default: 0, note: "0 = position, 1 = telemetry"]
  data jsonb [not null]
  created_at timestamptz [not null, default: `now()`]
}
Ref: drone_data.drone_id > drones.id
Ref: drone_data.flight_id > flights.id


Table drone_media {
  id serial [primary key, not null]
  drone_id integer [not null]
  flight_id integer [not null]
  type integer [not null, note: "0 = video, 1 = picture, 2 = panorama"]
  file_id integer [not null]
  fingerprint text [not null]
  tiny_fingerprint text [not null]
  meta text//json encoded meta data
  captured_at timestamptz
  received_at timestamptz [not null, default: `now()`]// when stored in db
  coverage text//json encoded coverage data
  coverage_generated_at timestamptz [not null, default: `now()`]
  camera_location text//json encoded {position: {longitude: number, latitude: number}, height: number}
  camera_angles text//json encoded {heading: number, pitch: number, roll: number}
}
Ref: drone_media.drone_id > drones.id
Ref: drone_media.file_id > files.id
Ref: drone_media.flight_id > flights.id


Table geo_objects {
  id serial [primary key, not null]
  uuid text [not null, unique, default: `uuid_generate_v4()`]
  workspace_id integer [not null]
  name text [not null]
  type integer [not null]
  sub_type integer [not null]
  config json [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  note: '''[TypescriptType]=

export type DBType_Geo_Object = DBType_Geo_Object_Base<0, 0> | DBType_Geo_Object_Base<0, 1> | DBType_Geo_Object_Base<0, 2> | DBType_Geo_Object_Base<0, 3> |
DBType_Geo_Object_Base<1, 0> | DBType_Geo_Object_Base<1, 1> | DBType_Geo_Object_Base<1, 2> | DBType_Geo_Object_Base<1, 3> | DBType_Geo_Object_Base<1, 4> |
DBType_Geo_Object_Base<2, 0> | DBType_Geo_Object_Base<2, 1> | DBType_Geo_Object_Base<2, 2> | DBType_Geo_Object_Base<2, 3> | DBType_Geo_Object_Base<2, 4> | DBType_Geo_Object_Base<2, 5> | DBType_Geo_Object_Base<2, 6>

export type DBType_Geo_Object_Base<type extends DBType_Geo_Object_TypeType, sub_type extends DBType_Geo_Object_SubTypeType<type>> = {
    id: number;
    uuid: string;
    workspace_id: number;
    name: string;
    type: type;
    sub_type: sub_type;
    config: DBType_Geo_Object_ConfigType<type, sub_type>;
    created_at: string;
    updated_at: string;
}


export type DBType_Geo_Object_TypeType = 0|1|2

export const DBType_Geo_Object_Type_TYPES = {
  marking: 0,
  traffic: 1,
  unit: 2
} as const

export type DBType_Geo_Object_SubTypeType<type extends DBType_Geo_Object_TypeType> =
    type extends 0 ? (0|1|2|3) :
    type extends 1 ? (0|1|2|3|4|5) :
    type extends 2 ? (0|1|2|3|4|5|6) : unknown


export const DBType_Geo_Object_SubType_TYPES = {
  marking: {
    point: 0,
    line: 1,
    polygon: 2,
    circle: 3
  },
  traffic: {
    airplane: 0,
    helicopter: 1,
    uav: 2,
    gliding: 3,
    other: 4
  },
  unit: {
    airplane: 0,
    helicopter: 1,
    uav: 2,
    pilot: 3,
    ground_vehicle: 4,
    ground_staff: 5,
    other: 6
  }
} as const

export type DBType_Geo_Object_ConfigType<type extends DBType_Geo_Object_TypeType, sub_type extends DBType_Geo_Object_SubTypeType<type>> = type extends 0 ? (
    sub_type extends 0 ? {point: [number, number, number], color: string} :
    sub_type extends 1 ? {line: [number, number, number][], color: string} :
    sub_type extends 2 ? {polygon: [number, number, number][], color: string} :
    sub_type extends 3 ? {center: [number, number, number], radius: number, color: string} : unknown
) : type extends 1 ? (
    {longitude: number, latitude: number, height: number, heading?: number, speed?: number}
) : type extends 2 ? (
    {longitude: number, latitude: number, symbol: string, height?: number, heading?: number, speed?: number}
) : unknown

  '''
}
Ref: geo_objects.workspace_id > workspaces.id
